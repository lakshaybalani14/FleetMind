# Public dashboard configuration (copy actual values from the FleetMind CDK stack outputs).
NEXT_PUBLIC_FLEET_API_URL=https://your-http-api.execute-api.ap-southeast-2.amazonaws.com
NEXT_PUBLIC_FLEET_WEBSOCKET_URL=wss://your-websocket-api.execute-api.ap-southeast-2.amazonaws.com/prod
NEXT_PUBLIC_COGNITO_DOMAIN=https://your-managed-login-domain.auth.ap-southeast-2.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-cognito-app-client-id

# Device credentials belong only in firmware/esp32-node/include/secrets.h (never here).
